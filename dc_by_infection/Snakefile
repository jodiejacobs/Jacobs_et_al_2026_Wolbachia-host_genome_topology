# =============================================================================
# diffDomain configuration (differential-TAD test, wMel vs DOX)
# =============================================================================
# diffDomain reads the .mcool/.cool contact matrices directly and, for each TAD
# in the reference condition's TAD list, tests whether that TAD's contact matrix
# is significantly reorganized in the other condition (largest singular value of
# the normalized difference matrix > 2; Tracy-Widom / random-matrix theory),
# then BH-corrects across TADs. The cooltools insulation output is used ONLY to
# build the TAD list (boundaries -> domain intervals).
#
# IMPORTANT before first run:
#   * DIFFDOMAIN_REPO must point at a `git clone https://github.com/Tian-Dechao/diffDomain`.
#   * The diffDomain env needs: python3, cooler, hicexplorer (hicConvertFormat),
#     hic-straw, TracyWidom, pandas, numpy, docopt, tqdm, matplotlib,
#     statsmodels, h5py, seaborn.
#   * Replicates are MERGED per condition (cooler merge sums raw counts), then
#     ICE-balanced, then fed to diffDomain. This tests condition-level
#     reorganization without modeling between-replicate variance -- the standard
#     two-matrix use of diffDomain. State this in your methods.
#   * DIFFDOMAIN_HICNORM: diffDomain extracts a balanced matrix via
#     `hicConvertFormat --correction_name {hicnorm}`. The merge rule's
#     `cooler balance` writes ICE weights under the name "weight", so "weight"
#     is the safe choice here. Use "KR" only if your matrices actually carry KR
#     vectors. Verify with `cooler dump --header` on a merged .cool.
#   * Chrom names in the TAD bed must match the cooler exactly (bare 2L/X/...,
#     no "chr" prefix). Both come from your dm6 pipeline, so they should match.
#   * --min_nbin drops TADs spanning fewer than that many bins. At 64 kb the
#     diffDomain default of 10 means only TADs >=640 kb are tested, which is
#     large for Drosophila; DIFFDOMAIN_MINNBIN is set to 5 here.
DIFFDOMAIN_REPO = "/private/groups/russelllab/jodie/wolbachia_induced_DE/Jacobs_et_al_2026_Wolbachia-host_genome_topology/dc_by_infection/tools/diffDomain"
DIFFDOMAIN_ENV  = "/private/groups/russelllab/jodie/miniforge3/envs/diffDomain"

DIFFDOMAIN_RESO    = 64000        # must be a resolution stored in the .mcool
DIFFDOMAIN_HICNORM = "weight"     # "weight" (ICE, written by cooler balance) or "KR"
DIFFDOMAIN_MINNBIN = 5            # diffDomain --min_nbin (bins per TAD floor)
DIFFDOMAIN_F       = 0.5          # diffDomain --f (missing-value filter, 0..1)
DIFFDOMAIN_NCORE   = 32
DIFFDOMAIN_REFCOND = "DOX"        # reference = hic0 = TAD-list source
DIFFDOMAIN_ALTCOND = "wMel"       # tested condition = hic1

# Map condition label -> the sample whose replicates to merge.
DIFFDOMAIN_SAMPLE = {"DOX": "JW18DOX", "wMel": "JW18wMel"}
# Replicate suffixes that exist on disk as {sample}-{rep}.matrix.mcool
DIFFDOMAIN_REPS = ["1", "2"]

DIFFDOMAIN_OUT = f"{output_dir}/diffdomain"

def _diffdomain_rep_mcools(cond):
    """Per-replicate .mcool inputs to merge for a condition."""
    s = DIFFDOMAIN_SAMPLE[cond]
    return [f"{data_dir}/{s}-{rep}.matrix.mcool" for rep in DIFFDOMAIN_REPS]

def _diffdomain_merged_cool(cond):
    """Merged, balanced single-resolution .cool diffDomain reads."""
    return f"{DIFFDOMAIN_OUT}/merged/{cond}_merged_{DIFFDOMAIN_RESO}.cool"


# Define the complete workflow
