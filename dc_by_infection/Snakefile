            --interaction_file {input.interaction_file} \
            --null_interaction_file {input.null_model} \
            --resolution {params.resolution} \
            --output_prefix {params.output_prefix}
        '''

# =============================================================================
# diffDomain rules: differential-TAD test (wMel vs DOX)
# =============================================================================

# 1. Convert cooltools insulation boundaries -> TAD intervals, per condition.
#    Depends on chromatin_structure_analysis having written the insulation TSVs.
rule insulation_to_tads:
    input:
        insulation = f"{output_dir}/chromatin_structure/chromatin_structure_{{cond}}_cooltools_insulation.tsv"
    output:
        tads = f"{DIFFDOMAIN_OUT}/tads/{{cond}}_tads.bed"
    params:
        reso         = DIFFDOMAIN_RESO,
        min_bins     = 2,
        chroms       = " ".join(chromosomes),
        boundary_col = "is_boundary_150000"   # matches your insulation TSV header
    resources:
        mem_mb = 8000,
        runtime = 20
    threads: 1
    shell:
        '''
        source $(dirname $(dirname $(which mamba)))/etc/profile.d/mamba.sh
        mamba activate {DIFFDOMAIN_ENV}

        mkdir -p {DIFFDOMAIN_OUT}/tads

        python scripts/insulation_to_tads.py \
            --insulation {input.insulation} \
            --output {output.tads} \
            --boundary-col {params.boundary_col} \
            --reso {params.reso} \
            --min-bins {params.min_bins} \
            --drop-bad-bins \
            --chroms {params.chroms}
        '''


# 1b. Merge replicates per condition into one balanced single-resolution .cool.
#     cooler merge sums raw counts; then re-balance (ICE) the merged matrix.
rule diffdomain_merge_replicates:
    input:
        reps = lambda wildcards: _diffdomain_rep_mcools(wildcards.cond)
    output:
        merged = f"{DIFFDOMAIN_OUT}/merged/{{cond}}_merged_{DIFFDOMAIN_RESO}.cool"
    params:
        reso = DIFFDOMAIN_RESO
    resources:
        mem_mb = 64000,
        runtime = 120
    threads: 8
    shell:
        '''
        source $(dirname $(dirname $(which mamba)))/etc/profile.d/mamba.sh
        mamba activate {DIFFDOMAIN_ENV}

        mkdir -p {DIFFDOMAIN_OUT}/merged

        # cooler merge needs single-resolution .cool files; extract reso/{params.reso}
        # from each replicate .mcool into a temporary .cool first.
        tmp_cools=""
        for f in {input.reps}; do
            base=$(basename "$f" .matrix.mcool)
            tmp="{DIFFDOMAIN_OUT}/merged/${{base}}_{params.reso}.tmp.cool"
            cooler cp "${{f}}::resolutions/{params.reso}" "${{tmp}}"
            tmp_cools="${{tmp_cools}} ${{tmp}}"
        done

        # Sum raw counts across replicates.
        cooler merge {output.merged} ${{tmp_cools}}

        # Balance (ICE) the merged matrix; --force in case a weight column exists.
        cooler balance -p {threads} --force {output.merged}

        # Clean up temporaries.
        rm -f ${{tmp_cools}}
        '''


# 2. Per-TAD Tracy-Widom test: reference TADs tested for reorganization in alt.
#    On first run, diffDomain builds a balanced sidecar next to each merged .cool
#    via hicConvertFormat (named ..._{reso/1000}k_{hicnorm}.cool). If you rebuild
#    a merged .cool, delete the stale sidecar so it regenerates.
rule diffdomain_dvsd:
    input:
        tads = f"{DIFFDOMAIN_OUT}/tads/{DIFFDOMAIN_REFCOND}_tads.bed",
        hic0 = _diffdomain_merged_cool(DIFFDOMAIN_REFCOND),
        hic1 = _diffdomain_merged_cool(DIFFDOMAIN_ALTCOND)
    output:
        raw = f"{DIFFDOMAIN_OUT}/raw_{DIFFDOMAIN_REFCOND}_vs_{DIFFDOMAIN_ALTCOND}.txt"
    params:
        reso     = DIFFDOMAIN_RESO,
        hicnorm  = DIFFDOMAIN_HICNORM,
        min_nbin = DIFFDOMAIN_MINNBIN,
        f        = DIFFDOMAIN_F,
        repo     = DIFFDOMAIN_REPO
    resources:
        mem_mb = 128000,
        runtime = 480
    threads: DIFFDOMAIN_NCORE
    shell:
        '''
        source $(dirname $(dirname $(which mamba)))/etc/profile.d/mamba.sh
        mamba activate {DIFFDOMAIN_ENV}

        mkdir -p {DIFFDOMAIN_OUT}

        python {params.repo}/diffdomain-py3/diffdomains.py dvsd multiple \
            {input.hic0} {input.hic1} {input.tads} \
            --reso {params.reso} \
            --hicnorm {params.hicnorm} \
            --min_nbin {params.min_nbin} \
            --f {params.f} \
            --ncore {threads} \
            --ofile {output.raw}
        '''


# 3. Benjamini-Hochberg adjustment of the raw p-values (full + BH<0.05 filtered).
rule diffdomain_adjust:
    input:
        raw = f"{DIFFDOMAIN_OUT}/raw_{DIFFDOMAIN_REFCOND}_vs_{DIFFDOMAIN_ALTCOND}.txt"
    output:
        adjusted = f"{DIFFDOMAIN_OUT}/reorganized_TADs_{DIFFDOMAIN_REFCOND}_vs_{DIFFDOMAIN_ALTCOND}.txt",
        filtered = f"{DIFFDOMAIN_OUT}/reorganized_TADs_{DIFFDOMAIN_REFCOND}_vs_{DIFFDOMAIN_ALTCOND}_BH_filtered.txt"
    params:
        repo = DIFFDOMAIN_REPO
    resources:
        mem_mb = 8000,
        runtime = 20
    threads: 1
    shell:
        '''
        source $(dirname $(dirname $(which mamba)))/etc/profile.d/mamba.sh
        mamba activate {DIFFDOMAIN_ENV}

        python {params.repo}/diffdomain-py3/diffdomains.py adjustment \
            fdr_bh {input.raw} {output.adjusted}

        python {params.repo}/diffdomain-py3/diffdomains.py adjustment \
            fdr_bh {input.raw} {output.filtered} --filter true
        '''


# 4. Classify significant reorganized TADs into six subtypes (needs alt TAD list).
rule diffdomain_classify:
    input:
        adjusted = f"{DIFFDOMAIN_OUT}/reorganized_TADs_{DIFFDOMAIN_REFCOND}_vs_{DIFFDOMAIN_ALTCOND}.txt",
        alt_tads = f"{DIFFDOMAIN_OUT}/tads/{DIFFDOMAIN_ALTCOND}_tads.bed"
    output:
        subtypes = f"{DIFFDOMAIN_OUT}/reorganized_TADs_{DIFFDOMAIN_REFCOND}_vs_{DIFFDOMAIN_ALTCOND}_subtypes.txt"
    params:
        repo  = DIFFDOMAIN_REPO,
        limit = 3 * DIFFDOMAIN_RESO   # 3-bin common-boundary tolerance (paper convention)
    resources:
        mem_mb = 16000,
        runtime = 60
    threads: 1
    shell:
        '''
        source $(dirname $(dirname $(which mamba)))/etc/profile.d/mamba.sh
        mamba activate {DIFFDOMAIN_ENV}

        python {params.repo}/diffdomain-py3/classification.py \
            -d {input.adjusted} \
            -t {input.alt_tads} \
            --limit {params.limit} \
            --out {output.subtypes}
        '''


# Helper rules
rule index_vcf:
    input:
        vcf = sv_vcf
    output:
        index = sv_vcf + ".tbi"
    shell:
        '''
        source $(dirname $(dirname $(which mamba)))/etc/profile.d/mamba.sh
        mamba activate {PYTHON_ENV}
        
        if [ ! -f {input.vcf}.gz ]; then
            bgzip -c {input.vcf} > {input.vcf}.gz
        fi
        tabix -p vcf {input.vcf}.gz
        '''

rule prepare_chip_peaks:
    input:
        chip_files = glob.glob(f"{chip_dir}/*.bed")
    output:
        touch(f"{chip_dir}/.prepared")
    shell:
        '''
        for file in {input.chip_files}; do
            if [[ ! -f "${{file}}.sorted" ]]; then
                sort -k1,1 -k2,2n ${{file}} > ${{file}}.sorted
                mv ${{file}}.sorted ${{file}}
            fi
        done
        touch {output}
        '''


# Clean up rule
rule clean:
    shell:
        '''
        rm -rf {output_dir}/temp_*
        rm -rf {output_dir}/*_temp_dir
        find {output_dir} -name "*.log" -delete
        '''
