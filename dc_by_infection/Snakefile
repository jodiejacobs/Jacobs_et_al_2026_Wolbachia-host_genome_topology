        # X chromosome analysis (with null comparisons)
        f"{output_dir}/x_analysis/x_chromosome_summary.tsv",
        f"{output_dir}/X_diffhic/comprehensive_tables/all_sig_interactions_combined.csv",

        f"{output_dir}/has_ces_analysis/has_summary.txt",
        f"{output_dir}/insulator_analysis/insulator/insulator_summary.txt",

